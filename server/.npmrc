# npm replaces dashes in npmrc keys with underscores when exporting npm_config_* env:
# onnxruntime-node-install-cuda -> npm_config_onnxruntime_node_install_cuda
# The onnxruntime-node install script reads npm_config_onnxruntime_node_install_cuda
# (script/install.js:173) and exits before downloading the ~200MB CUDA/TensorRT
# providers when skip. npm-native equivalent of the pnpm patchedDependencies fix.
onnxruntime-node-install-cuda=skip
