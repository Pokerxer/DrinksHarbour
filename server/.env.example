# DrinksHarbour API — environment template
#
# Copy to .env and fill in. Only the "Required" block is needed to boot the
# server; every other integration degrades gracefully when its keys are absent
# (the feature is disabled or falls back to a stub, the process still starts).
#
# Never commit the filled-in .env — it is gitignored.

# ── Required ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/drinksharbour
JWT_SECRET=
JWT_REFRESH_SECRET=
PORT=5001
NODE_ENV=development

# Some older maintenance scripts in server/scripts/ still read MONGO_URI.
# Set it to the same value if you run those.
MONGO_URI=mongodb://127.0.0.1:27017/drinksharbour

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Where the apps live (used in emails, redirects, CORS) ───────────────────
FRONTEND_URL=http://localhost:3002
PLATFORM_URL=http://localhost:3002
ADMIN_URL=http://localhost:3000
BACKEND_URL=http://localhost:5001
APP_NAME=DrinksHarbour

# ── Payments (NGN) ──────────────────────────────────────────────────────────
PAYMENT_GATEWAY=korapay
KORAPAY_SECRET_KEY=
PAYSTACK_SECRET_KEY=

# Paystack plan codes for the ERM subscription tiers
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_GROWTH=
PAYSTACK_PLAN_PRO=
PAYSTACK_PLAN_ENTERPRISE=
PAYSTACK_PLAN_VENUE=

# ── Images ──────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (SMTP send + IMAP for the support inbox) ──────────────────────────
# MAIL_PORT 465 is SMTP-only; IMAP uses 993.
SENDER_EMAIL_ADDRESS=
MAIL_DISPLAY_NAME=DrinksHarbour
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_PASSWORD=
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_CRED_KEY=
ADMIN_EMAIL=

# Optional second mailbox for the support inbox
MAIL_ACCOUNT_2_ADDRESS=
MAIL_ACCOUNT_2_DISPLAY_NAME=
MAIL_ACCOUNT_2_PASSWORD=

# Gmail OAuth alternative to SMTP password auth
MAILING_SERVICE_CLIENT_ID=
MAILING_SERVICE_CLIENT_SECRET=
MAILING_REFRESH_TOKEN=

# ── AI (content generation, chatbot, product enrichment, embeddings) ────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_FAST_MODEL=
ANTHROPIC_SMART_MODEL=
ANTHROPIC_WEB_SEARCH_TOOL=
ANTHROPIC_RESEARCH_MODEL=
ANTHROPIC_RESEARCH_EFFORT=
ANTHROPIC_RESEARCH_MAX_SEARCHES=
ANTHROPIC_RESEARCH_TIMEOUT_MS=

EMBEDDING_PROVIDER=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=
COHERE_API_KEY=
COHERE_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=

# Web search grounding for AI product/blog content
SERPER_API_KEY=

# Text-to-speech
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=
FISH_AUDIO_VOICE_ID=

# ── Maps, delivery routing, shipping origin ─────────────────────────────────
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
WAREHOUSE_LAT=
WAREHOUSE_LON=

# ── Messaging ───────────────────────────────────────────────────────────────
TERMII_API_KEY=
TERMII_BASE_URL=
TERMII_SENDER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=

# ── Nigerian identity / business verification ───────────────────────────────
SMILE_PARTNER_ID=
SMILE_API_KEY=
VERIFYME_API_KEY=
CAC_SEARCH_API_KEY=
FIRS_API_KEY=

# ── Misc ────────────────────────────────────────────────────────────────────
GIFTCARD_QR_SECRET=
EXCHANGE_RATE_API_URL=
EXCHANGE_RATE_SYNC_TTL_MINUTES=
ENABLE_CRON=false
BACKUP_DIR=
PINTEREST_ACCESS_TOKEN=
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_ADMIN_URL=
