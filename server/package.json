{
  "name": "drinksharbour-backend",
  "version": "1.0.0",
  "description": "DrinksHarbour Multi-Tenant E-commerce Backend",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "test": "node --test '__tests__/*.test.js'",
    "start": "node server.js",
    "dev": "nodemon -x 'node -r dotenv/config server.js'",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@huggingface/transformers": "3.8.1",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "chalk": "^4.1.2",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.3.2",
    "google-auth-library": "11.3.4",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "imapflow": "^2.11.0",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.14.3",
    "mammoth": "^1.12.0",
    "mongoose": "^9.12.1",
    "morgan": "^1.10.1",
    "multer": "^2.5.0",
    "naija-state-local-government": "^1.1.2",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "nodemailer": "10.5.0",
    "papaparse": "^5.7.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.4",
    "streamifier": "^0.1.1",
    "stripe": "^23.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@types/nodemailer": "^8.0.2",
    "nodemon": "^3.0.2",
    "redis": "^6.3.1"
  },
  "nodemonConfig": {
    "watch": [
      "server.js",
      "config/**/*.js",
      "controllers/**/*.js",
      "middleware/**/*.js",
      "models/**/*.js",
      "routes/**/*.js",
      "services/**/*.js",
      "utils/**/*.js",
      "schemas/**/*.js"
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules/**",
      "scripts/**",
      "*.log",
      ".git/**"
    ],
    "exec": "node server.js",
    "env": {
      "NODE_ENV": "development"
    },
    "restartable": "rs",
    "colours": true,
    "delay": "1000"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "overrides": {
    "@huggingface/transformers": {
      "sharp": "0.35.5"
    }
  }
}
